generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                            String                    @id @default(uuid())
  email                         String                    @unique
  passwordHash                  String                    @map("password_hash")
  name                          String
  avatarUrl                     String?                   @map("avatar_url")
  currency                      String                    @default("CLP")
  country                       String?
  language                      String                    @default("es")
  isVerified                    Boolean                   @default(false) @map("is_verified")
  createdAt                     DateTime                  @default(now()) @map("created_at")
  updatedAt                     DateTime                  @updatedAt @map("updated_at")
  defaultSharedExpenseAccountId String?                   @map("default_shared_expense_account_id")
  accounts                      Account[]
  budgets                       Budget[]
  expenseParticipations         ExpenseParticipant[]
  groupSplitDefaults            GroupMemberSplitDefault[]
  groupMemberships              GroupMember[]
  groupsCreated                 Group[]                   @relation("GroupCreator")
  importHistory                 ImportHistory[]
  borrowedLoans                 Loan[]                    @relation("BorrowedLoans")
  loans                         Loan[]                    @relation("UserLoans")
  notifications                 Notification[]
  paymentsFrom                  Payment[]                 @relation("PaymentsFrom")
  paymentsTo                    Payment[]                 @relation("PaymentsTo")
  sharedExpensesPaid            SharedExpense[]           @relation("PaidBy")
  tags                          Tag[]
  transactions                  Transaction[]
  categoryOverrides             UserCategoryOverride[]    @relation("UserCategoryOverrides")
  dashboardPreference           UserDashboardPreference?
  defaultSharedExpenseAccount   Account?                  @relation("DefaultSharedExpenseAccount", fields: [defaultSharedExpenseAccountId], references: [id])
  investmentHoldings            InvestmentHolding[]
  investmentTransactions        InvestmentTransaction[]

  @@map("users")
}

model Account {
  id                                   String          @id @default(uuid())
  userId                               String          @map("user_id")
  name                                 String
  type                                 AccountType
  balance                              Decimal         @db.Decimal(15, 2)
  currency                             String          @default("CLP")
  isDefault                            Boolean         @default(false) @map("is_default")
  creditLimit                          Decimal?        @map("credit_limit") @db.Decimal(15, 2)
  billingDay                           Int?            @map("billing_day")
  createdAt                            DateTime        @default(now()) @map("created_at")
  updatedAt                            DateTime        @updatedAt @map("updated_at")
  isArchived                           Boolean         @default(false) @map("is_archived")
  includeInTotalBalance                Boolean         @default(true) @map("include_in_total_balance")
  accountNumber                        String?         @map("account_number")
  color                                String?
  user                                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  importHistory                        ImportHistory[]
  transactions                         Transaction[]
  transfersDestination                 Transaction[]   @relation("TransferDestination")
  usersWithDefaultSharedExpenseAccount User[]          @relation("DefaultSharedExpenseAccount")
  investmentHoldings                   InvestmentHolding[]
  investmentTransactions               InvestmentTransaction[]

  @@index([userId])
  @@index([userId, isArchived])
  @@map("accounts")
}

model Transaction {
  id                   String                @id @default(uuid())
  userId               String                @map("user_id")
  accountId            String                @map("account_id")
  type                 TransactionType
  amount               Decimal               @db.Decimal(15, 2)
  categoryId           String?               @map("category_id")
  description          String?
  date                 DateTime              @default(now())
  receiptUrl           String?               @map("receipt_url")
  payee                String?
  payer                String?
  toAccountId          String?               @map("to_account_id")
  sharedExpenseId      String?               @map("shared_expense_id")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  loanId               String?               @unique @map("loan_id")
  importedTransactions ImportedTransaction[]
  loanPayment          LoanPayment?
  tags                 TransactionTag[]
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  loan                 Loan?                 @relation("LoanTransaction", fields: [loanId], references: [id])
  sharedExpense        SharedExpense?        @relation(fields: [sharedExpenseId], references: [id])
  toAccount            Account?              @relation("TransferDestination", fields: [toAccountId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([date])
  @@index([type])
  @@index([toAccountId])
  @@index([sharedExpenseId])
  @@index([loanId])
  @@index([userId, date])
  @@index([userId, type, date])
  @@index([accountId, date])
  @@index([userId, payee])
  @@map("transactions")
}

model CategoryTemplate {
  id               String                 @id @default(uuid())
  name             String
  icon             String?
  color            String?
  type             TransactionType
  parentTemplateId String?                @map("parent_template_id")
  orderIndex       Int                    @default(0) @map("order_index")
  isSystem         Boolean                @default(true) @map("is_system")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  parent           CategoryTemplate?      @relation("CategoryTemplateHierarchy", fields: [parentTemplateId], references: [id], onDelete: Cascade)
  subcategories    CategoryTemplate[]     @relation("CategoryTemplateHierarchy")
  userOverrides    UserCategoryOverride[]

  @@unique([name, parentTemplateId])
  @@index([parentTemplateId])
  @@index([type])
  @@map("category_templates")
}

model UserCategoryOverride {
  id               String                 @id @default(uuid())
  userId           String                 @map("user_id")
  templateId       String?                @map("template_id")
  name             String
  icon             String?
  color            String?
  isActive         Boolean                @default(true) @map("is_active")
  isCustom         Boolean                @default(false) @map("is_custom")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  type             TransactionType
  parentOverrideId String?                @map("parent_override_id")
  parent           UserCategoryOverride?  @relation("CustomCategoryHierarchy", fields: [parentOverrideId], references: [id], onDelete: Cascade)
  subcategories    UserCategoryOverride[] @relation("CustomCategoryHierarchy")
  template         CategoryTemplate?      @relation(fields: [templateId], references: [id])
  user             User                   @relation("UserCategoryOverrides", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([userId])
  @@index([templateId])
  @@index([parentOverrideId])
  @@index([isActive])
  @@index([type])
  @@map("user_category_overrides")
}

model Tag {
  id           String           @id @default(uuid())
  userId       String           @map("user_id")
  name         String
  color        String?
  createdAt    DateTime         @default(now()) @map("created_at")
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model TransactionTag {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  tagId         String      @map("tag_id")
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, tagId])
  @@index([transactionId])
  @@index([tagId])
  @@map("transaction_tags")
}

model Budget {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Decimal  @db.Decimal(15, 2)
  month     Int
  year      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year], name: "userId_month_year")
  @@index([userId])
  @@map("budgets")
}

model Group {
  id                   String                    @id @default(uuid())
  name                 String
  description          String?
  coverImageUrl        String?                   @map("cover_image_url")
  createdBy            String                    @map("created_by")
  defaultSplitType     SplitType?                @default(EQUAL) @map("default_split_type")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  defaultSplitSettings GroupMemberSplitDefault[]
  members              GroupMember[]
  creator              User                      @relation("GroupCreator", fields: [createdBy], references: [id])
  payments             Payment[]
  sharedExpenses       SharedExpense[]

  @@index([createdBy])
  @@map("groups")
}

model GroupMemberSplitDefault {
  id          String   @id @default(uuid())
  groupId     String   @map("group_id")
  userId      String   @map("user_id")
  percentage  Decimal? @db.Decimal(5, 2)
  shares      Int?
  exactAmount Decimal? @db.Decimal(15, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_member_split_defaults")
}

model GroupMember {
  id       String   @id @default(uuid())
  groupId  String   @map("group_id")
  userId   String   @map("user_id")
  joinedAt DateTime @default(now()) @map("joined_at")
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

model SharedExpense {
  id           String               @id @default(uuid())
  groupId      String               @map("group_id")
  paidByUserId String               @map("paid_by_user_id")
  amount       Decimal              @db.Decimal(15, 2)
  description  String
  categoryId   String?              @map("category_id")
  date         DateTime             @default(now())
  receiptUrl   String?              @map("receipt_url")
  splitType    SplitType            @default(EQUAL) @map("split_type")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  participants ExpenseParticipant[]
  group        Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy       User                 @relation("PaidBy", fields: [paidByUserId], references: [id])
  transactions Transaction[]

  @@index([groupId])
  @@index([paidByUserId])
  @@index([categoryId])
  @@index([groupId, date])
  @@index([paidByUserId, date])
  @@map("shared_expenses")
}

model ExpenseParticipant {
  id         String        @id @default(uuid())
  expenseId  String        @map("expense_id")
  userId     String        @map("user_id")
  amountOwed Decimal       @map("amount_owed") @db.Decimal(15, 2)
  percentage Decimal?      @db.Decimal(5, 2)
  shares     Int?
  isPaid     Boolean       @default(false) @map("is_paid")
  paidDate   DateTime?     @map("paid_date")
  paidAmount Decimal?      @map("paid_amount") @db.Decimal(15, 2)
  expense    SharedExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
  @@index([userId, isPaid])
  @@map("expense_participants")
}

model Payment {
  id         String   @id @default(uuid())
  groupId    String?  @map("group_id")
  fromUserId String   @map("from_user_id")
  toUserId   String   @map("to_user_id")
  amount     Decimal  @db.Decimal(15, 2)
  date       DateTime @default(now())
  createdAt  DateTime @default(now()) @map("created_at")
  from       User     @relation("PaymentsFrom", fields: [fromUserId], references: [id])
  group      Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  to         User     @relation("PaymentsTo", fields: [toUserId], references: [id])

  @@index([groupId])
  @@index([fromUserId])
  @@index([toUserId])
  @@index([fromUserId, date])
  @@index([toUserId, date])
  @@map("payments")
}

model Loan {
  id              String        @id @default(uuid())
  userId          String        @map("user_id")
  borrowerName    String        @map("borrower_name")
  borrowerUserId  String?       @map("borrower_user_id")
  originalAmount  Decimal       @map("original_amount") @db.Decimal(15, 2)
  paidAmount      Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 2)
  currency        String        @default("CLP")
  loanDate        DateTime      @default(now()) @map("loan_date")
  notes           String?
  status          LoanStatus    @default(ACTIVE)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  payments        LoanPayment[]
  borrowerUser    User?         @relation("BorrowedLoans", fields: [borrowerUserId], references: [id])
  user            User          @relation("UserLoans", fields: [userId], references: [id], onDelete: Cascade)
  loanTransaction Transaction?  @relation("LoanTransaction")

  @@index([userId, status])
  @@index([borrowerUserId])
  @@index([userId, loanDate])
  @@map("loans")
}

model LoanPayment {
  id            String       @id @default(uuid())
  loanId        String       @map("loan_id")
  amount        Decimal      @db.Decimal(15, 2)
  paymentDate   DateTime     @default(now()) @map("payment_date")
  transactionId String?      @unique @map("transaction_id")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  loan          Loan         @relation(fields: [loanId], references: [id], onDelete: Cascade)
  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([loanId])
  @@map("loan_payments")
}

model ImportHistory {
  id                   String                @id @default(uuid())
  userId               String                @map("user_id")
  accountId            String                @map("account_id")
  fileName             String                @map("file_name")
  fileType             String                @map("file_type")
  totalRows            Int                   @map("total_rows")
  successCount         Int                   @default(0) @map("success_count")
  failedCount          Int                   @default(0) @map("failed_count")
  status               ImportHistoryStatus   @default(PROCESSING)
  importedAt           DateTime              @default(now()) @map("imported_at")
  completedAt          DateTime?             @map("completed_at")
  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  importedTransactions ImportedTransaction[]

  @@index([userId])
  @@index([accountId])
  @@index([importedAt])
  @@index([status])
  @@map("import_history")
}

model ImportedTransaction {
  id              String        @id @default(uuid())
  importHistoryId String        @map("import_history_id")
  transactionId   String?       @map("transaction_id")
  rowNumber       Int           @map("row_number")
  status          ImportStatus
  errorMessage    String?       @map("error_message")
  originalDate    String        @map("original_date")
  type            String
  amount          String
  description     String
  category        String?
  tags            String?
  notes           String?
  importHistory   ImportHistory @relation(fields: [importHistoryId], references: [id], onDelete: Cascade)
  transaction     Transaction?  @relation(fields: [transactionId], references: [id])

  @@index([importHistoryId])
  @@index([transactionId])
  @@map("imported_transactions")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model UserDashboardPreference {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  widgets   Json     @default("[]")
  layout    Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_dashboard_preferences")
}

enum AccountType {
  CASH
  DEBIT
  CREDIT
  SAVINGS
  INVESTMENT
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum SplitType {
  EQUAL
  PERCENTAGE
  EXACT
  SHARES
}

enum LoanStatus {
  ACTIVE
  PAID
  CANCELLED
}

enum ImportStatus {
  SUCCESS
  FAILED
}

enum ImportHistoryStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum NotificationType {
  PAYMENT_RECEIVED
  SHARED_EXPENSE_CREATED
  GROUP_MEMBER_ADDED
  BALANCE_SETTLED
}

enum InvestmentAssetType {
  CRYPTO
  STOCK
  ETF
  FOREX
}

enum InvestmentTransactionType {
  BUY
  SELL
  DIVIDEND
  INTEREST
}

// Holdings actuales del usuario (posiciones abiertas)
model InvestmentHolding {
  id                    String                    @id @default(uuid())
  userId                String                    @map("user_id")
  accountId             String                    @map("account_id")
  assetSymbol           String                    @map("asset_symbol")
  assetName             String                    @map("asset_name")
  assetType             InvestmentAssetType       @map("asset_type")
  totalQuantity         Decimal                   @map("total_quantity") @db.Decimal(20, 8)
  averageCostPerUnit    Decimal                   @map("average_cost_per_unit") @db.Decimal(15, 2)
  totalCostBasis        Decimal                   @map("total_cost_basis") @db.Decimal(15, 2)
  realizedGainLoss      Decimal                   @default(0) @map("realized_gain_loss") @db.Decimal(15, 2)
  currency              String                    @default("USD")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions          InvestmentTransaction[]

  @@unique([accountId, assetSymbol])
  @@index([userId])
  @@index([accountId])
  @@index([userId, accountId])
  @@map("investment_holdings")
}

// Historial de transacciones (compras/ventas)
model InvestmentTransaction {
  id                String                    @id @default(uuid())
  userId            String                    @map("user_id")
  accountId         String                    @map("account_id")
  holdingId         String                    @map("holding_id")
  assetSymbol       String                    @map("asset_symbol")
  assetType         InvestmentAssetType       @map("asset_type")
  type              InvestmentTransactionType
  quantity          Decimal                   @db.Decimal(20, 8)
  pricePerUnit      Decimal                   @map("price_per_unit") @db.Decimal(15, 2)
  totalAmount       Decimal                   @map("total_amount") @db.Decimal(15, 2)
  fees              Decimal                   @default(0) @db.Decimal(15, 2)
  exchangeRate      Decimal?                  @map("exchange_rate") @db.Decimal(15, 6)
  currency          String                    @default("USD")
  transactionDate   DateTime                  @default(now()) @map("transaction_date")
  notes             String?
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  user              User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  holding           InvestmentHolding         @relation(fields: [holdingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
  @@index([holdingId])
  @@index([userId, transactionDate])
  @@index([accountId, transactionDate])
  @@map("investment_transactions")
}

// Cache de precios para evitar rate limits
model InvestmentPriceCache {
  id              String              @id @default(uuid())
  assetSymbol     String              @map("asset_symbol")
  assetType       InvestmentAssetType @map("asset_type")
  price           Decimal             @db.Decimal(15, 8)
  currency        String              @default("USD")
  change24h       Decimal?            @map("change_24h") @db.Decimal(10, 4)
  timestamp       DateTime            @default(now())
  source          String

  @@unique([assetSymbol, assetType])
  @@index([assetSymbol])
  @@index([timestamp])
  @@map("investment_price_cache")
}
